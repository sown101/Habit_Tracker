<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#161616"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp">

        <FrameLayout
            android:id="@+id/frameIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/viewIconBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/darker_gray" />

            <TextView
                android:id="@+id/txtIconEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⭐"
                android:textSize="27sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtHabitTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Habit Name"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/layoutActionContainer"
            app:layout_constraintStart_toEndOf="@id/frameIcon"
            app:layout_constraintTop_toTopOf="@id/frameIcon" />

        <TextView
            android:id="@+id/txtHabitStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:text="🔥 0 Days"
            android:textColor="#FF9E2C"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/frameIcon"
            app:layout_constraintTop_toBottomOf="@id/txtHabitTitle" />

        <TextView
            android:id="@+id/txtHabitSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today"
            android:textColor="#C7C7C7"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/layoutActionContainer"
            app:layout_constraintStart_toEndOf="@id/frameIcon"
            app:layout_constraintTop_toBottomOf="@id/txtHabitStreak" />

        <FrameLayout
            android:id="@+id/layoutActionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutCompleteAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/cbHabitComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#45D26A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCounterAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnPlus"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_timer_circle"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#D4B8C4"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCounterValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2 / 5 times"
                    android:textColor="#BFB7CF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTimerAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnStartTimer"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_timer_circle"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#B8A7FF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtTimerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="00:00 / 15:00"
                    android:textColor="#BFB7CF"
                    android:textSize="11sp" />
            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>