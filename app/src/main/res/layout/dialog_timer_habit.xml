<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0714"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnCloseTimer"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#E7DBFF" />

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCloseTimer">

        <View
            android:id="@+id/viewHabitIconBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_timer_icon" />

        <TextView
            android:id="@+id/txtHabitIconEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⏰"
            android:textSize="34sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvHabitName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Habit"
        android:textColor="#F4EDFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconContainer" />

    <TextView
        android:id="@+id/tvTimerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Chạm vòng tròn để tạm dừng"
        android:textColor="#AFA3D7"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHabitName" />

    <FrameLayout
        android:id="@+id/timerCircleWrap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toTopOf="@id/btnStopTimer"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTimerHint">

        <!-- Vòng nền -->
        <View
            android:id="@+id/viewTimerRingBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_timer_circle" />

        <!-- Chấm sáng trên đỉnh -->
        <View
            android:id="@+id/viewTimerDot"
            android:layout_width="44dp"
            android:layout_height="18dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_timer_dot" />

        <!-- Text thời gian -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="00:15:00"
            android:textColor="#CDBDFF"
            android:textSize="50sp"
            android:textStyle="bold" />

        <!-- Progress text -->
        <TextView
            android:id="@+id/tvTimerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="52dp"
            android:text="00:00 / 15:00"
            android:textColor="#9D91C5"
            android:textSize="16sp" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnStopTimer"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_stop_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="#4B3A78" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>