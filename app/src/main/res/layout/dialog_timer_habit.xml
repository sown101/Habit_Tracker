<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#0B0616"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#D8C8FF" />

        <TextView
            android:id="@+id/txtHabitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Habit"
            android:textColor="#D8C8FF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTimerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mục tiêu: 15 phút"
            android:textColor="#B9A8E6"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="15:00"
            android:textColor="#D8C8FF"
            android:textSize="56sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnStartPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_pill_gray"
                android:src="@android:drawable/ic_media_play"
                app:tint="#5D46A8" />

            <Space
                android:layout_width="18dp"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_pill_gray"
                android:src="@android:drawable/ic_delete"
                app:tint="#5D46A8" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>