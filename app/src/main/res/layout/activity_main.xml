<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".ui.main.MainActivity">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/arc_center"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="250dp"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/arc_hill"
        android:layout_width="700dp"
        android:layout_height="700dp"
        android:background="@drawable/bg_arc_nav_hill"
        app:layout_constraintBottom_toBottomOf="@+id/arc_center"
        app:layout_constraintEnd_toEndOf="@+id/arc_center"
        app:layout_constraintStart_toStartOf="@+id/arc_center"
        app:layout_constraintTop_toTopOf="@+id/arc_center" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_folder"
        app:backgroundTint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintCircle="@+id/arc_center"
        app:layout_constraintCircleAngle="332"
        app:layout_constraintCircleRadius="350dp"
        android:tint="#757575"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_calendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_calendar"
        app:backgroundTint="@android:color/white"
        app:fabSize="normal"
        app:layout_constraintCircle="@+id/arc_center"
        app:layout_constraintCircleAngle="345"
        app:layout_constraintCircleRadius="350dp"
        android:tint="#757575"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/green_primary"
        app:layout_constraintCircle="@+id/arc_center"
        app:layout_constraintCircleAngle="0"
        app:layout_constraintCircleRadius="350dp"
        app:maxImageSize="30dp"
        app:tint="@android:color/white"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_stats"
        app:backgroundTint="@android:color/white"
        app:fabSize="normal"
        app:layout_constraintCircle="@+id/arc_center"
        app:layout_constraintCircleAngle="15"
        app:layout_constraintCircleRadius="350dp"
        android:tint="#757575"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bell"
        app:backgroundTint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintCircle="@+id/arc_center"
        app:layout_constraintCircleAngle="28"
        app:layout_constraintCircleRadius="350dp"
        android:tint="#757575"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>